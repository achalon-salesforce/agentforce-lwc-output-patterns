<?xml version="1.0" encoding="UTF-8"?>
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this to show the user a text input so they can enter their favorite sports team. On confirm, saves the team to the user's profile and sends a confirmation message.</description>
    <invocationTarget>SaveFavoriteTeam</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>Save Favorite Team</masterLabel>
    <progressIndicatorMessage>Saving your team...</progressIndicatorMessage>
</GenAiFunction>
