<?xml version="1.0" encoding="UTF-8"?>
<GenAiFunction xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Use this to display the user's favorite sports team as a styled card. Pass a JSON payload with title, subtitle, teamName, and message fields.</description>
    <invocationTarget>SaveFavoriteTeamOutput</invocationTarget>
    <invocationTargetType>flow</invocationTargetType>
    <isConfirmationRequired>false</isConfirmationRequired>
    <isIncludeInProgressIndicator>true</isIncludeInProgressIndicator>
    <masterLabel>Show Favorite Team</masterLabel>
    <progressIndicatorMessage>Loading your team...</progressIndicatorMessage>
</GenAiFunction>
